# Production secrets for docker compose (do not commit .env.production)
# cp .env.production.example .env.production

# Vault / AES key material — use a long random passphrase
NOTES_PASSWORD=change-me-to-a-long-random-vault-passphrase

# Cookie signing secret — keep stable across deploys
SESSION_SECRET=change-me-to-a-long-random-session-secret

# Public site URL (must match DNS + Caddy)
APP_PUBLIC_URL=https://onepiece.prayushadhikari.com.np

PORT=4173

# Never enable demo seeding in production
# ALLOW_DEMO_USER=false
