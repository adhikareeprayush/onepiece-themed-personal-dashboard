{
  "name": "personal-notes",
  "version": "1.0.0",
  "private": true,
  "description": "Personal One Piece–themed toolkit: notes, encrypted password vault, and quests",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "pack:extension": "bash scripts/pack-extension.sh"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^16.2.1",
    "sanitize-html": "^2.17.0"
  }
}
