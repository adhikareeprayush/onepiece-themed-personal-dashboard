# Choose a password and put it after the equals sign.
# This unlocks the app and encrypts the Treasure Vault.
NOTES_PASSWORD=replace-this-with-your-password

# Cookie signing secret — keep stable across restarts.
SESSION_SECRET=replace-with-a-long-random-string

# Public URL (local or production domain)
APP_PUBLIC_URL=http://localhost:4173

# You normally do not need to change this for local use.
PORT=4173

# Production: see .env.production.example and DEPLOY.md
# APP_PUBLIC_URL=https://onepiece.prayushadhikari.com.np
