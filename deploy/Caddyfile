# HTTPS edge for Grand Line Tools
# DNS must point onepiece.prayushadhikari.com.np at this machine.
# Caddy obtains/renews Let's Encrypt certificates automatically.

onepiece.prayushadhikari.com.np {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:4173 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}
}
